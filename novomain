def cadastrar_solicitante():
    """Insere um novo solicitante na tabela cadastro_solicitantes."""
    print("\n── Cadastrar Solicitante ──")
    nome     = input("Nome: ").strip()
    email    = input("Email: ").strip()
    telefone = input("Telefone: ").strip()

    if not nome:
        print("Nome não pode ser vazio.")
        return

    conn = criar_conexao()
    if not conn:
        return
    try:
        cursor = conn.cursor()
        sql = "INSERT INTO cadastro_solicitantes (nome, email, telefone) VALUES (%s, %s, %s)"
        cursor.execute(sql, (nome, email, telefone))
        conn.commit()
        print(f"Solicitante '{nome}' cadastrado com sucesso! (ID: {cursor.lastrowid})")
    except Error as e:
        print(f"Erro ao cadastrar solicitante: {e}")
    finally:
        cursor.close()
        conn.close()


def listar_solicitantes():
    """Exibe todos os solicitantes cadastrados."""
    print("\n── Listar Solicitantes ──")

    conn = criar_conexao()
    if not conn:
        return
    try:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM cadastro_solicitantes ORDER BY nome")
        rows = cursor.fetchall()

        if not rows:
            print("Nenhum solicitante cadastrado.")
            return

        print(f"\n{'ID':<6} {'Nome':<30} {'Email':<35} {'Telefone'}")
        print("─" * 80)
        for row in rows:
            print(f"{row[0]:<6} {row[1]:<30} {row[2]:<35} {row[3]}")

    except Error as e:
        print(f"Erro ao listar solicitantes: {e}")
    finally:
        cursor.close()
        conn.close()

def editar_solicitante():
    """Atualiza os dados de um solicitante existente."""
    print("\n── Editar Solicitante ──")
    listar_solicitantes()

    try:
        id_editar = int(input("\nDigite o ID do solicitante a editar: "))
    except ValueError:
        print("ID inválido.")
        return

    conn = criar_conexao()
    if not conn:
        return
    try:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM cadastro_solicitantes WHERE codigo = %s", (id_editar,))
        solicitante = cursor.fetchone()
        if not solicitante:
            print("Solicitante não encontrado.")
            return

        print(f"\nDados atuais → Nome: {solicitante[1]} | Email: {solicitante[2]} | Telefone: {solicitante[3]}")
        print("(Pressione Enter para manter o valor atual)")

        novo_nome     = input(f"Novo nome [{solicitante[1]}]: ").strip() or solicitante[1]
        novo_email    = input(f"Novo email [{solicitante[2]}]: ").strip() or solicitante[2]
        novo_telefone = input(f"Novo telefone [{solicitante[3]}]: ").strip() or solicitante[3]

        sql = "UPDATE cadastro_solicitantes SET nome=%s, email=%s, telefone=%s WHERE codigo=%s"
        cursor.execute(sql, (novo_nome, novo_email, novo_telefone, id_editar))
        conn.commit()
        print("Solicitante atualizado com sucesso!")
    except Error as e:
        print(f"Erro ao editar solicitante: {e}")
    finally:
        cursor.close()
        conn.close()

def excluir_solicitante():
    """Remove um solicitante do banco de dados."""
    print("\n── Excluir Solicitante ──")
    listar_solicitantes()

    try:
        id_excluir = int(input("\nDigite o ID do solicitante a excluir: "))
    except ValueError:
        print("ID inválido.")
        return

    confirmacao = input(f"Confirma exclusão do ID {id_excluir}? (s/n): ").strip().lower()
    if confirmacao != 's':
        print("Exclusão cancelada.")
        return

    conn = criar_conexao()
    if not conn:
        return
    try:
        cursor = conn.cursor()
        cursor.execute("DELETE FROM cadastro_solicitantes WHERE codigo = %s", (id_excluir,))
        conn.commit()
        if cursor.rowcount:
            print("Solicitante excluído com sucesso!")
        else:
            print("Solicitante não encontrado.")
    except Error as e:
        print(f"Erro ao excluir solicitante: {e}")
    finally:
        cursor.close()
        conn.close()

